<?xml version="1.0" encoding="utf-8"?>
<!-- Light palette for day mode; values-night/colors.xml holds the dark palette.
     The system picks between them, so the app follows the phone's day/night setting. -->
<resources>
    <color name="accent">#0E9F8A</color>
    <color name="background">#F6F9F8</color>
    <color name="surface">#E9EFED</color>
    <color name="text">#10181A</color>
    <color name="muted">#5C6B68</color>
    <color name="ok">#1E9E57</color>
    <color name="warn">#B97F16</color>
    <color name="bad">#DE3B32</color>
    <color name="icon_bg">#E0E8E5</color>
    <bool name="light_bars">true</bool>
</resources>
